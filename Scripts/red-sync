#!/bin/bash
# REDACTED — safe two-way GitHub sync for macOS
# Local edits are committed first, then the GitHub main branch is integrated,
# then the result is pushed. Only proven-safe metadata conflicts auto-resolve;
# no reset, forced push, or unverified file-content preference.
set -euo pipefail

PROJECT="${REDACTED_PROJECT:-$HOME/Documents/Redacted}"
REPO="https://github.com/K1ng-Kat/Redacted.git"

printf '\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n'
printf '       REDACTED GITHUB SYNC\n'
printf '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n'
printf '📁 Project: %s\n' "$PROJECT"

if ! command -v git >/dev/null 2>&1; then
    echo '❌ Git is not installed or available in PATH.'
    exit 1
fi

if [[ ! -e "$PROJECT" ]]; then
    echo '📦 Local project not found. Cloning from GitHub...'
    mkdir -p "$(dirname "$PROJECT")"
    git clone "$REPO" "$PROJECT"
fi

if ! git -C "$PROJECT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo '❌ This folder is not a Git repository. No files were changed.'
    exit 1
fi

root="$(git -C "$PROJECT" rev-parse --show-toplevel)"
if [[ "$root" != "$PROJECT" ]]; then
    echo "❌ Expected repository root: $PROJECT"
    echo "   Found: $root"
    exit 1
fi

remote="$(git -C "$PROJECT" remote get-url origin 2>/dev/null || true)"
case "$remote" in
    https://github.com/K1ng-Kat/Redacted|https://github.com/K1ng-Kat/Redacted.git|git@github.com:K1ng-Kat/Redacted|git@github.com:K1ng-Kat/Redacted.git|ssh://git@github.com/K1ng-Kat/Redacted|ssh://git@github.com/K1ng-Kat/Redacted.git)
        ;;
    *)
        echo '❌ The origin remote is not K1ng-Kat/Redacted. Sync cancelled.'
        echo "   Found: $remote"
        exit 1
        ;;
esac

branch="$(git -C "$PROJECT" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
if [[ "$branch" != 'main' ]]; then
    echo "❌ Checked-out branch is '${branch:-DETACHED}', not 'main'."
    echo '   Switch to main yourself before running red-sync.'
    exit 1
fi

gitdir="$(git -C "$PROJECT" rev-parse --absolute-git-dir)"
if [[ -d "$gitdir/rebase-merge" || -d "$gitdir/rebase-apply" || -f "$gitdir/MERGE_HEAD" || -f "$gitdir/CHERRY_PICK_HEAD" ]]; then
    echo '❌ A merge, rebase, or cherry-pick is in progress. Resolve it first.'
    exit 1
fi

if [[ -n "$(git -C "$PROJECT" status --porcelain)" ]]; then
    echo ''
    echo '📝 Local edits found:'
    git -C "$PROJECT" status --short
    echo ''
    echo '📦 Saving local changes in a Git commit...'
    git -C "$PROJECT" add -A

    # Avoid accidentally uploading credentials, private signing keys or profiles.
    unsafe=''
    while IFS= read -r -d '' path; do
        if printf '%s\n' "$path" | LC_ALL=C grep -Eiq '(^|/)\.env($|\.)|(^|/)GoogleService-Info\.plist$|\.(p8|p12|pem|key|mobileprovision)$|(^|/)(id_rsa|id_ed25519)$'; then
            unsafe="$path"
            break
        fi
    done < <(git -C "$PROJECT" diff --cached --name-only --diff-filter=ACMR -z)

    if [[ -n "$unsafe" ]]; then
        echo "❌ Potentially sensitive file detected: $unsafe"
        echo '   Nothing was committed or pushed. Review your staged files.'
        exit 1
    fi

    if ! git -C "$PROJECT" diff --cached --quiet; then
        git -C "$PROJECT" commit -m "Sync local Redacted changes ($(date '+%Y-%m-%d %H:%M:%S'))"
        echo '✅ Local changes safely committed.'
    else
        echo '✅ No tracked changes needed committing.'
    fi
else
    echo '✅ No uncommitted local changes.'
fi

echo ''
echo '🔄 Fetching latest GitHub main...'
if ! git -C "$PROJECT" fetch origin main; then
    echo '❌ Fetch failed. Your local commits and files are safe.'
    exit 1
fi

echo '📥 Integrating GitHub updates...'
# A named recovery branch protects every pre-merge local commit.
if ! git -C "$PROJECT" merge-base --is-ancestor HEAD origin/main; then
    backup="red-sync-backup-$(date '+%Y%m%d-%H%M%S')-$(git -C "$PROJECT" rev-parse --short HEAD)"
    git -C "$PROJECT" branch "$backup"
    echo "🛟 Local recovery branch: $backup"
fi

# A normal merge preserves the local commit history and the app icon.
if ! git -C "$PROJECT" merge --no-edit origin/main; then
    xcode_conflict='Redacted.xcodeproj/project.pbxproj'
    plist_conflict='Redacted-Info.plist'
    files="$(git -C "$PROJECT" diff --name-only --diff-filter=U)"
    resolved=false
    supported=true
    have_xcode=false
    have_plist=false

    # Only auto-resolve these two known app metadata files. Unknown conflicts
    # are left untouched, and the merge is rolled back to the recovery branch.
    while IFS= read -r file; do
        [[ -z "$file" ]] && continue
        case "$file" in
            "$xcode_conflict") have_xcode=true ;;
            "$plist_conflict") have_plist=true ;;
            *) supported=false ;;
        esac
    done <<< "$files"

    if [[ "$supported" == true ]] &&
       [[ "$have_xcode" == true || "$have_plist" == true ]] &&
       command -v python3 >/dev/null 2>&1; then

        tmp="$(mktemp -d)"
        merge_ready=true
        echo '🔧 Safely reconciling Xcode settings and app Info.plist...'

        if [[ "$have_xcode" == true ]]; then
            # This pre-existing helper preserves the ENTIRE local project file,
            # including signing/team/capability edits. It only accepts the
            # remote version/build change; anything else is a hard stop.
            if [[ ! -f "$PROJECT/Scripts/resolve_xcode_project.py" ]] ||
               ! git -C "$PROJECT" show ":1:$xcode_conflict" > "$tmp/pbx-base" ||
               ! git -C "$PROJECT" show ":2:$xcode_conflict" > "$tmp/pbx-local" ||
               ! git -C "$PROJECT" show ":3:$xcode_conflict" > "$tmp/pbx-remote" ||
               ! python3 "$PROJECT/Scripts/resolve_xcode_project.py" \
                    "$tmp/pbx-base" "$tmp/pbx-local" "$tmp/pbx-remote" "$tmp/pbx-result"; then
                merge_ready=false
            fi
        fi

        if [[ "$have_plist" == true ]]; then
            if ! git -C "$PROJECT" show ":1:$plist_conflict" > "$tmp/plist-base" ||
               ! git -C "$PROJECT" show ":2:$plist_conflict" > "$tmp/plist-local" ||
               ! git -C "$PROJECT" show ":3:$plist_conflict" > "$tmp/plist-remote"; then
                merge_ready=false
            elif ! python3 - "$tmp/plist-base" "$tmp/plist-local" \
                "$tmp/plist-remote" "$tmp/plist-result" <<'PYTHON_PLIST_MERGE'
import plistlib
import sys
from pathlib import Path

base_path, local_path, remote_path, result_path = map(Path, sys.argv[1:])
missing = object()
base, local, remote = [
    plistlib.loads(path.read_bytes()) for path in (base_path, local_path, remote_path)
]

def merge(base_value, local_value, remote_value, location):
    if local_value == remote_value:
        return local_value
    if local_value == base_value:
        return remote_value
    if remote_value == base_value:
        return local_value
    if all(isinstance(value, dict) for value in
           (base_value, local_value, remote_value)):
        merged = {}
        for key in dict.fromkeys([*base_value, *local_value, *remote_value]):
            value = merge(
                base_value.get(key, missing),
                local_value.get(key, missing),
                remote_value.get(key, missing),
                f"{location}.{key}"
            )
            if value is not missing:
                merged[key] = value
        return merged
    raise ValueError(f"Both sides changed {location} differently; review required.")

try:
    result = merge(base, local, remote, "Info.plist")
    if not isinstance(result, dict):
        raise ValueError("Unexpected non-dictionary Info.plist")

    # Don't accidentally lose the QR deep link, Game Mode or camera permission.
    if result.get("LSSupportsGameMode") is not True:
        raise ValueError("Game Mode plist setting missing")
    if result.get("UILaunchStoryboardName") != "LaunchScreen":
        raise ValueError("Launch storyboard setting missing")
    if not result.get("NSCameraUsageDescription"):
        raise ValueError("QR scanner camera permission missing")
    schemes = [
        scheme
        for item in result.get("CFBundleURLTypes", [])
        for scheme in item.get("CFBundleURLSchemes", [])
    ]
    if "redacted-detective" not in schemes:
        raise ValueError("Multiplayer invite URL scheme missing")

    result_path.write_bytes(plistlib.dumps(result, sort_keys=False))
    print("✅ Preserved local plist settings and GitHub camera/QR/Game Mode keys.")
except (ValueError, TypeError, plistlib.InvalidFileException) as error:
    print(f"❌ Plist cannot be safely auto-merged: {error}", file=sys.stderr)
    sys.exit(1)
PYTHON_PLIST_MERGE
            then
                merge_ready=false
            fi
        fi

        # Commit only after BOTH outputs have been validated.
        if [[ "$merge_ready" == true ]]; then
            if [[ "$have_xcode" == true ]]; then
                cp "$tmp/pbx-result" "$PROJECT/$xcode_conflict"
            fi
            if [[ "$have_plist" == true ]]; then
                cp "$tmp/plist-result" "$PROJECT/$plist_conflict"
            fi

            if command -v plutil >/dev/null 2>&1 &&
               { [[ "$have_xcode" != true ]] ||
                 plutil -lint -s "$PROJECT/$xcode_conflict"; } &&
               { [[ "$have_plist" != true ]] ||
                 plutil -lint -s "$PROJECT/$plist_conflict"; }; then
                if [[ "$have_xcode" == true ]]; then
                    git -C "$PROJECT" add -- "$xcode_conflict"
                fi
                if [[ "$have_plist" == true ]]; then
                    git -C "$PROJECT" add -- "$plist_conflict"
                fi
                if git -C "$PROJECT" diff --cached --check &&
                   git -C "$PROJECT" commit --no-edit; then
                    resolved=true
                    echo '✅ Xcode project and Info.plist safely merged.'
                fi
            fi
        fi
        rm -rf "$tmp"
    fi

    if [[ "$resolved" != true ]]; then
        echo '⚠️ Settings overlap could not be reconciled safely; aborting.'
        if git -C "$PROJECT" rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then
            git -C "$PROJECT" merge --abort || {
                echo '❌ Automatic rollback failed. Inspect git status before continuing.'
                exit 1
            }
        fi
        echo '❌ All local and GitHub commits are preserved. Nothing was force-pushed.'
        echo '   The recovery branch remains available for manual review.'
        exit 1
    fi
fi

echo '📤 Pushing the synchronized project to GitHub...'
if ! git -C "$PROJECT" push origin main; then
    echo '❌ Push failed (possibly due to authentication or new remote commits).'
    echo '   Local commits are safe. Fix the issue and run red-sync again.'
    exit 1
fi

printf '\n✅ REDACTED FULLY SYNCED!\n'
printf '✅ Local and GitHub main match\n'
printf '🔖 Commit: %s\n' "$(git -C "$PROJECT" rev-parse --short HEAD)"
printf '📂 %s\n\n' "$PROJECT"
